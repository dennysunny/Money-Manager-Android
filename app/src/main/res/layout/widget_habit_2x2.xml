<?xml version="1.0" encoding="utf-8"?>
<!-- Vivo OriginOS Daily Habit Tracker Atomic Widget (2x2) with Dark Mode Support -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_habit_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="0dp">

    <!-- Atomic Card Container: 26dp corner radius, clipToOutline, 14dp default inner padding -->
    <LinearLayout
        android:id="@+id/widget_habit_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_atomic_card_bg"
        android:clipToOutline="true"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: Title & Progress Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:text="HABITS"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_habit_status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pixel_pill_success"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:singleLine="true"
                android:text="0/0 Done"
                android:textColor="@color/widget_success_pill_text"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Habit Items Directly on Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_habit_item_1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:text="✓ No Dining Out"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_habit_item_2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:text="✓ Cook at Home"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_habit_item_3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:text="○ Track Expenses"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Footer: Streak chip & Log Action -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_habit_streak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/widget_pixel_pill_secondary"
                android:gravity="center"
                android:paddingStart="7dp"
                android:paddingTop="4dp"
                android:paddingEnd="7dp"
                android:paddingBottom="4dp"
                android:singleLine="true"
                android:text="🔥 Active Streak"
                android:textColor="@color/widget_streak_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_habit_open_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_pixel_pill_primary"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="Log →"
                android:textColor="@color/widget_pill_primary_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- OriginOS Footer Label: 28dp slot, -2.5dp optical lift -> 11.5dp below card bottom -->
    <TextView
        android:id="@+id/widget_habit_atomic_label"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.015"
        android:lineHeight="16.52sp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:shadowColor="#8C000000"
        android:shadowDx="0"
        android:shadowDy="1.0"
        android:shadowRadius="2.0"
        android:singleLine="true"
        android:text="Habits"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:translationY="-2.5dp"
        tools:targetApi="p" />

</LinearLayout>
