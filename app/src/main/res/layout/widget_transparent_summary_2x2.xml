<?xml version="1.0" encoding="utf-8"?>
<!-- Vivo OriginOS Transparent Summary Atomic Widget (2x2) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_2x2_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="0dp">

    <!-- Atomic Card Container: 26dp corner radius, clipToOutline, 14dp default inner padding -->
    <LinearLayout
        android:id="@+id/widget_2x2_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_transparent_card_bg"
        android:clipToOutline="true"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header Row: Month Pill & Quick Add Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_2x2_month"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/widget_transparent_pill"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:paddingStart="9dp"
                android:paddingTop="3dp"
                android:paddingEnd="9dp"
                android:paddingBottom="3dp"
                android:singleLine="true"
                android:text="THIS MONTH"
                android:textColor="@color/widget_transparent_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_2x2_add_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_pixel_pill_primary"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="+ Add"
                android:textColor="@color/widget_pill_primary_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Center Content: Chart & Financial Totals -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_2x2_pie_chart"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Category Spending Pie Chart" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#90000000"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:text="Spent"
                    android:textColor="@color/widget_transparent_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_2x2_spent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sf_mono"
                    android:shadowColor="#A0000000"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:singleLine="true"
                    android:text="₹0.00"
                    android:textColor="#F87171"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:shadowColor="#90000000"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:text="Net Balance"
                    android:textColor="@color/widget_transparent_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_2x2_balance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sf_mono"
                    android:shadowColor="#A0000000"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:singleLine="true"
                    android:text="₹0.00"
                    android:textColor="#4ADE80"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Chips: Velocity & Daily Spend Indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_2x2_today_chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/widget_transparent_pill"
                android:fontFamily="@font/sf_mono"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp"
                android:singleLine="true"
                android:text="Today: ₹0"
                android:textColor="@color/widget_transparent_text_primary"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_2x2_velocity_chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/widget_transparent_pill"
                android:fontFamily="@font/sf_mono"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp"
                android:singleLine="true"
                android:text="₹0/day"
                android:textColor="#818CF8"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- OriginOS Footer Label: 28dp slot, -2.5dp optical lift -> 11.5dp below card bottom -->
    <TextView
        android:id="@+id/widget_2x2_atomic_label"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.015"
        android:lineHeight="16.52sp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:shadowColor="#8C000000"
        android:shadowDx="0"
        android:shadowDy="1.0"
        android:shadowRadius="2.0"
        android:singleLine="true"
        android:text="Summary"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:translationY="-2.5dp"
        tools:targetApi="p" />

</LinearLayout>
